{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakl-math.invalid/schemas/retrospective-correction-chronology-receipt.schema.json",
  "title": "RAKL_math retrospective correction chronology receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "atom_id",
    "recorded_at",
    "trigger",
    "historical_bindings",
    "chronology_audit",
    "classification",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "atom_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "trigger": {
      "const": "POST_V2_CURRENT_RAKL_CHRONOLOGY_AUDIT"
    },
    "historical_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1",
        "v2",
        "correction_receipt",
        "correction_trace",
        "correction_review"
      ],
      "properties": {
        "v1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "final_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "v2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "final_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "correction_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "final_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "correction_trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "final_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "correction_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "final_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "chronology_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_sequence",
        "missing_before_v2_candidate",
        "strict_trace_valid_for_v2_successor_discovery",
        "historical_trace_bytes_preserved",
        "finding"
      ],
      "properties": {
        "observed_sequence": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_before_v2_candidate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strict_trace_valid_for_v2_successor_discovery": {
          "const": false
        },
        "historical_trace_bytes_preserved": {
          "const": true
        },
        "finding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v2_correction",
        "strict_successor_discovery_credit",
        "mathematical_truth_effect",
        "future_gate_effect",
        "independent_review",
        "novelty_authority",
        "root_authority"
      ],
      "properties": {
        "v2_correction": {
          "const": "RETROSPECTIVE_EXTERNAL_REVIEW_CORRECTION"
        },
        "strict_successor_discovery_credit": {
          "const": "NONE"
        },
        "mathematical_truth_effect": {
          "const": "UNCHANGED_POSITIVE_Q_LOCAL_DERIVATION"
        },
        "future_gate_effect": {
          "const": "FUTURE_CANDIDATES_ONLY"
        },
        "independent_review": {
          "const": false
        },
        "novelty_authority": {
          "const": "NONE"
        },
        "root_authority": {
          "const": "NONE"
        }
      }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
