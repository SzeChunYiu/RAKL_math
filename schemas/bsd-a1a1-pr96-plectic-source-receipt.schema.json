{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL_math/schemas/bsd-a1a1-pr96-plectic-source-receipt.schema.json",
  "title": "BSD A1a1 PR96 plectic exact-source receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "retrieval", "sources", "scope_boundary", "authority", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "bsd-a1a1-pr96-plectic-source-receipt-v1"},
    "receipt_id": {"const": "BSD-A1a1-PR96-PLECTIC-SOURCES-20260811-V1"},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_at_utc", "endpoint", "snapshot_path", "snapshot_sha256", "snapshot_size_bytes"],
      "properties": {
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "endpoint": {"type": "string", "format": "uri"},
        "snapshot_path": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshot_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["versioned_id", "title", "authors", "updated", "abstract_sha256", "abs_url", "pdf_url", "pdf_sha256", "pdf_size_bytes", "claim_check"],
        "properties": {
          "versioned_id": {"enum": ["2603.28327v2", "2311.03100v2", "2202.12573v2"]},
          "title": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "updated": {"type": "string", "format": "date-time"},
          "abstract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "abs_url": {"type": "string", "format": "uri"},
          "pdf_url": {"type": "string", "format": "uri"},
          "pdf_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "pdf_size_bytes": {"type": "integer", "minimum": 1},
          "claim_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "supported_statement", "non_guarantees"],
            "properties": {
              "status": {"const": "SUPPORTED_AT_RECORDED_SCOPE"},
              "supported_statement": {"type": "string", "minLength": 1},
              "non_guarantees": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "scope_boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority": {"const": "VERSIONED_SOURCE_RECEIPT_ONLY_NO_THEOREM_OR_ROOT_AUTHORITY"},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
