{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL_math/schemas/postmerge-assurance-correction-receipt.schema.json",
  "title": "RAKL Math postmerge assurance correction receipt",
  "description": "Immutable successor audit for already-merged application artifacts. It records defects without rewriting history or granting retroactive discovery credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "recorded_at",
    "application_repository",
    "framework_authority",
    "preserved_artifacts",
    "schema_audit",
    "hash_audit",
    "chronology_audit",
    "successors",
    "correction",
    "positive_evidence_preserved",
    "authority_contract",
    "evidence_pointers",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "application_repository": {"$ref": "#/$defs/applicationRepository"},
    "framework_authority": {"$ref": "#/$defs/frameworkAuthority"},
    "preserved_artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/preservedArtifact"}
    },
    "schema_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_error_count", "memory_error_count", "pretrace_error_count", "continuation_error_count", "task_episode_error_count", "failure_lattice_error_count", "strict_process_verdict", "findings"],
      "properties": {
        "context_error_count": {"const": 14},
        "memory_error_count": {"const": 5},
        "pretrace_error_count": {"const": 2},
        "continuation_error_count": {"const": 2},
        "task_episode_error_count": {"const": 1},
        "failure_lattice_error_count": {"const": 2},
        "strict_process_verdict": {"const": "INVALID_NO_RETROACTIVE_REPAIR"},
        "findings": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/schemaFinding"}
        }
      }
    },
    "hash_audit": {"$ref": "#/$defs/hashAudit"},
    "chronology_audit": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/chronologyDiscrepancy"}
    },
    "successors": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/successor"}
    },
    "correction": {"$ref": "#/$defs/correction"},
    "positive_evidence_preserved": {"$ref": "#/$defs/nonEmptyStrings"},
    "authority_contract": {"$ref": "#/$defs/authorityContract"},
    "evidence_pointers": {"$ref": "#/$defs/nonEmptyStrings"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "applicationRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "pre_pr_base_commit", "pr_head_commit", "pr_head_tree", "merge_commit", "merge_tree", "merge_parents"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "pre_pr_base_commit": {"$ref": "#/$defs/sha1"},
        "pr_head_commit": {"$ref": "#/$defs/sha1"},
        "pr_head_tree": {"$ref": "#/$defs/sha1"},
        "merge_commit": {"$ref": "#/$defs/sha1"},
        "merge_tree": {"$ref": "#/$defs/sha1"},
        "merge_parents": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/sha1"},
            {"$ref": "#/$defs/sha1"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "schemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob_sha": {"$ref": "#/$defs/sha1"}
      }
    },
    "frameworkAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "historical_application_pin", "current_main_commit", "current_main_tree", "schema_bindings"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "historical_application_pin": {"$ref": "#/$defs/sha1"},
        "current_main_commit": {"$ref": "#/$defs/sha1"},
        "current_main_tree": {"$ref": "#/$defs/sha1"},
        "schema_bindings": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/schemaBinding"}}
      }
    },
    "preservedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha", "content_sha256", "introduced_commit", "introduced_commit_time"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob_sha": {"$ref": "#/$defs/sha1"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "introduced_commit": {"$ref": "#/$defs/sha1"},
        "introduced_commit_time": {"type": "string", "format": "date-time"}
      }
    },
    "schemaFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "schema_path", "error_count", "violations"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "schema_path": {"type": "string", "minLength": 1},
        "error_count": {"type": "integer", "minimum": 1},
        "violations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "hashFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "stored_hash", "computed_remove_key_hash", "matches_remove_key"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "stored_hash": {"$ref": "#/$defs/sha256"},
        "computed_remove_key_hash": {"$ref": "#/$defs/sha256"},
        "matches_remove_key": {"type": "boolean"}
      }
    },
    "hashAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_historical_rule", "successor_rule", "findings", "downstream_content_anchor_status"],
      "properties": {
        "observed_historical_rule": {"const": "UNDOCUMENTED_CANONICAL_JSON_SHA256_WITH_HASH_KEY_REMOVED"},
        "successor_rule": {"const": "CANONICAL_JSON_SHA256_WITH_ARTIFACT_HASH_BLANK"},
        "findings": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hashFinding"}},
        "downstream_content_anchor_status": {"const": "E08_TO_E12_CHAIN_FROM_NONREPRODUCIBLE_E07_STORED_HASH"}
      }
    },
    "chronologyDiscrepancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "claimed_timestamp", "introducing_commit", "introducing_commit_time", "future_offset_seconds"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "claimed_timestamp": {"type": "string", "format": "date-time"},
        "introducing_commit": {"$ref": "#/$defs/sha1"},
        "introducing_commit_time": {"type": "string", "format": "date-time"},
        "future_offset_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "artifact_hash"],
      "properties": {
        "kind": {"enum": ["CANONICAL_TASK_EPISODE", "PROPOSAL_TELEMETRY_AUTHORITY_RECEIPT", "SCHEMA_VALID_FAILURE_LATTICE"]},
        "path": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "strict_discovery_credit", "root_authority", "originals_preserved", "repairs_original_chronology", "prospective_child_atom"],
      "properties": {
        "classification": {"const": "RETROSPECTIVE_ROUTE_PRUNING"},
        "strict_discovery_credit": {"const": "NO_STRICT_DISCOVERY_CREDIT"},
        "root_authority": {"const": "ROOT_AUTHORITY_NONE"},
        "originals_preserved": {"const": true},
        "repairs_original_chronology": {"const": false},
        "prospective_child_atom": {"const": "NS-B1a2"}
      }
    },
    "authorityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_authority", "allowed_effect", "grants_strict_discovery_credit", "grants_proof_authority", "grants_root_authority", "grants_theorem_authority", "grants_framework_authority", "grants_review_independence", "may_backfill_chronology"],
      "properties": {
        "effective_authority": {"const": "RETROSPECTIVE_ROUTE_PRUNING_ONLY"},
        "allowed_effect": {"const": "NEGATIVE_HISTORY_AND_SEARCH_PRIORITY_ONLY"},
        "grants_strict_discovery_credit": {"const": false},
        "grants_proof_authority": {"const": false},
        "grants_root_authority": {"const": false},
        "grants_theorem_authority": {"const": false},
        "grants_framework_authority": {"const": false},
        "grants_review_independence": {"const": false},
        "may_backfill_chronology": {"const": false}
      }
    }
  }
}
