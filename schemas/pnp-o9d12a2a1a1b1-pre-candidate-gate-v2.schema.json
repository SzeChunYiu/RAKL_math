{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL_math/schemas/pnp-o9d12a2a1a1b1-pre-candidate-gate-v2.schema.json",
  "title": "P-vs-NP O9d12a2a1a1b1 prospective V2 pre-candidate gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "atom_id", "status", "recorded_at", "source_binding", "freshness_check", "supersession", "artifacts", "runtime_gate", "test_runs", "authority_contract", "next_action", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "rakl-math-pnp-pre-candidate-gate-v2"},
    "receipt_id": {"const": "RAKL-MATH-PNP-O9d12a2a1a1b1-PRE-CANDIDATE-GATE-V2-20260811"},
    "atom_id": {"const": "O9d12a2a1a1b1"},
    "status": {"const": "PROSPECTIVE_PROCESS_GATES_PASS_CANDIDATE_GENERATION_ALLOWED_NO_CANDIDATE"},
    "recorded_at": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 30},
    "source_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_url", "application_base_sha", "framework_repository_url", "framework_pin", "primary_source", "primary_source_pdf_sha256"],
      "properties": {
        "repository_url": {"type": "string", "minLength": 1},
        "application_base_sha": {"$ref": "#/$defs/git_sha"},
        "framework_repository_url": {"type": "string", "minLength": 1},
        "framework_pin": {"$ref": "#/$defs/git_sha"},
        "primary_source": {"type": "string", "minLength": 1},
        "primary_source_pdf_sha256": {"$ref": "#/$defs/raw_sha256"}
      }
    },
    "freshness_check": {
      "type": "object", "additionalProperties": false,
      "required": ["checked_at", "branch_moved", "local_base_sha", "origin_main_sha", "left_count", "right_count"],
      "properties": {
        "checked_at": {"type": "string", "format": "date-time", "minLength": 20, "maxLength": 30},
        "branch_moved": {"const": false},
        "local_base_sha": {"$ref": "#/$defs/git_sha"},
        "origin_main_sha": {"$ref": "#/$defs/git_sha"},
        "left_count": {"const": 0},
        "right_count": {"const": 0}
      }
    },
    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": ["v0_status", "v0_correction_path", "v0_correction_hash", "historical_bytes_modified"],
      "properties": {
        "v0_status": {"const": "REJECTED_PRE_CANDIDATE_AUTHORIZATION"},
        "v0_correction_path": {"const": "receipts/pnp-o9d12a2a1a1b1-v0-hostile-failure-20260811.json"},
        "v0_correction_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "historical_bytes_modified": {"const": false}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "prefixItems": [
        {"$ref": "#/$defs/a0"}, {"$ref": "#/$defs/a1"}, {"$ref": "#/$defs/a2"}, {"$ref": "#/$defs/a3"}, {"$ref": "#/$defs/a4"}, {"$ref": "#/$defs/a5"}, {"$ref": "#/$defs/a6"}, {"$ref": "#/$defs/a7"}, {"$ref": "#/$defs/a8"}, {"$ref": "#/$defs/a9"}, {"$ref": "#/$defs/a10"}
      ],
      "items": false
    },
    "runtime_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["context_packet_hash", "memory_review_hash", "expert_review_hash", "trace_terminal_hash", "context_gate", "memory_gate", "trace_gate", "plan_math_research"],
      "properties": {
        "context_packet_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "memory_review_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "expert_review_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "trace_terminal_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "context_gate": {"$ref": "#/$defs/pass_gate"},
        "memory_gate": {"$ref": "#/$defs/pass_gate"},
        "trace_gate": {"$ref": "#/$defs/pass_gate"},
        "plan_math_research": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_generation_allowed", "pre_candidate_actions", "candidate_paths_used", "candidate_identity"],
          "properties": {
            "candidate_generation_allowed": {"const": true},
            "pre_candidate_actions": {"type": "array", "minItems": 0, "maxItems": 0},
            "candidate_paths_used": {"const": false},
            "candidate_identity": {"type": "null"}
          }
        }
      }
    },
    "test_runs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/focused_run"},
        {"$ref": "#/$defs/full_run"}
      ],
      "items": false
    },
    "authority_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_proposed", "mathematical_result", "proof_authority", "novelty_authority", "independent_peer_review", "p_vs_np_authority", "framework_promotion_authority"],
      "properties": {
        "candidate_proposed": {"const": false}, "mathematical_result": {"const": false}, "proof_authority": {"const": false}, "novelty_authority": {"const": false}, "independent_peer_review": {"const": false}, "p_vs_np_authority": {"const": false}, "framework_promotion_authority": {"const": false}
      }
    },
    "next_action": {"const": "SOURCE_NATIVE_T_RULE_THEOREM_INVENTORY_IN_A_SEPARATE_VERSIONED_ROUND"},
    "artifact_hash": {"$ref": "#/$defs/prefixed_sha256"}
  },
  "$defs": {
    "git_sha": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "raw_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "prefixed_sha256": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_base": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/raw_sha256"}}
    },
    "a0": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "receipts/pnp-o9d12a2a1a1b1-v0-hostile-failure-20260811.json"}, "kind": {"const": "V0_FAILURE_CORRECTION"}}}]},
    "a1": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/02_problem_dag/O9d12a2a1a1b1_ATOMIZATION_V2_20260811.json"}, "kind": {"const": "ATOMIZATION"}}}]},
    "a2": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/01_frontier/O9d12a2a1a1b1_MATH_CONTEXT_FIBER_V2_20260811.json"}, "kind": {"const": "MATH_CONTEXT_FIBER"}}}]},
    "a3": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/01_frontier/O9d12a2a1a1b1_SOURCE_AND_TRANSFER_PACKET_V2_20260811.md"}, "kind": {"const": "SOURCE_SYNTHESIS"}}}]},
    "a4": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/07_memory/O9d12a2a1a1b1_TOOL_SNAPSHOT_V2_20260811.json"}, "kind": {"const": "TOOL_SNAPSHOT"}}}]},
    "a5": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/07_memory/O9d12a2a1a1b1_FAILURE_SNAPSHOT_V2_20260811.json"}, "kind": {"const": "FAILURE_SNAPSHOT"}}}]},
    "a6": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/07_memory/O9d12a2a1a1b1_NONCANONICAL_PARENT_WARNING_V2_20260811.json"}, "kind": {"const": "NONCANONICAL_WARNING"}}}]},
    "a7": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/07_memory/O9d12a2a1a1b1_RESEARCH_MEMORY_REVIEW_V2_20260811.json"}, "kind": {"const": "RESEARCH_MEMORY_REVIEW"}}}]},
    "a8": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/07_memory/O9d12a2a1a1b1_MEMORY_FREEZE_V2_20260811.json"}, "kind": {"const": "MEMORY_FREEZE"}}}]},
    "a9": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/08_reviews/SAME_CONTEXT_EXPERT_REVIEW_O9d12a2a1a1b1_PRE_CANDIDATE_V2_20260811.json"}, "kind": {"const": "EXPERT_CONTEXT_REVIEW"}}}]},
    "a10": {"allOf": [{"$ref": "#/$defs/artifact_base"}, {"properties": {"path": {"const": "research/real_math/millennium/p_vs_np/09_trace/O9d12a2a1a1b1_PRE_CANDIDATE_TRACE_V2_20260811.json"}, "kind": {"const": "MATH_RESEARCH_TRACE"}}}]},
    "pass_gate": {"type": "object", "additionalProperties": false, "required": ["verdict", "reasons"], "properties": {"verdict": {"const": "PASS"}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "run_base": {"type": "object", "additionalProperties": false, "required": ["scope", "command", "result", "passed", "failed", "duration_seconds"], "properties": {"scope": {"type": "string"}, "command": {"type": "string"}, "result": {"const": "PASS"}, "passed": {"type": "integer", "minimum": 1}, "failed": {"const": 0}, "duration_seconds": {"type": "number", "minimum": 0}}},
    "focused_run": {"allOf": [{"$ref": "#/$defs/run_base"}, {"properties": {"scope": {"const": "FOCUSED_V2_GATE_PRE_RECEIPT"}, "command": {"const": "PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONINTMAXSTRDIGITS=0 python tools/run_application_tests.py --framework framework/RAKL -- tests/math_applications/test_pnp_o9d12a2a1a1b1_pre_candidate_v2.py"}, "passed": {"const": 1}}}]},
    "full_run": {"allOf": [{"$ref": "#/$defs/run_base"}, {"properties": {"scope": {"const": "EXACT_APPLICATION_SUITE_PRE_RECEIPT"}, "command": {"const": "PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONINTMAXSTRDIGITS=0 python tools/run_application_tests.py --framework framework/RAKL"}, "passed": {"const": 426}}}]}
  }
}
