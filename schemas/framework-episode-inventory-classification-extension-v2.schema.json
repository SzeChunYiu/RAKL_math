  "$id": "https://rakl-math.local/schemas/framework-episode-inventory-classification-extension-v2.schema.json",
  "title": "RAKL_math non-TaskEpisode inventory classification extension receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "recorded_at", "object", "qoi",
    "lineage", "audit_binding", "classifications", "disposition",
    "authority_contract", "evidence_pointers", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "receipt_id": {"const": "RAKL-MATH-TASK-EPISODE-INVENTORY-CLASSIFICATION-EXTENSION-NS-B1A3B1-R2-V2-20260811"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "object": {"type": "string", "minLength": 1},
    "qoi": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_parent_inventory", "preserved_prior_extension"],
      "properties": {
        "frozen_parent_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_path", "receipt_artifact_hash", "receipt_blob_at_merge",
            "receipt_file_sha256", "merge_commit", "frozen_episode_count"
          ],
          "properties": {
            "receipt_path": {"const": "receipts/framework-pr153-hash-contract-migration-20260811.json"},
            "receipt_artifact_hash": {"const": "sha256:a607a86135e4acbfeb551af86e8dd10febfeb0a3d461daf53c4862339e5c0f77"},
            "receipt_blob_at_merge": {"const": "92135fdc9db0f37679fa5656e7052c7e02e00ec3"},
