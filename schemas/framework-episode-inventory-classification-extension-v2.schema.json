            "merge_commit": {"const": "b18fcd35855d67962e28036f4a445ab24d0c4406"},
            "frozen_episode_count": {"const": 19}
          }
        },
        "preserved_prior_extension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_path", "introduction_commit", "introduction_tree",
            "git_blob_sha", "raw_sha256", "receipt_artifact_hash"
          ],
          "properties": {
            "receipt_path": {"const": "receipts/framework-episode-inventory-extension-h4d1b-20260811.json"},
            "introduction_commit": {"const": "7d664b20dc691170d86d9757aaa5edd1db16ddb4"},
            "introduction_tree": {"const": "a886af4ec504c40ab0e2e0392f4e3a7f0b8dafa6"},
            "git_blob_sha": {"const": "cb8296b8b7491afc0c655430b8c65c8fd92e16eb"},
            "raw_sha256": {"const": "68c1c9c33b4a0c438a1a8fac865718de1c7a7e4bc111d881037b38fe30eb5216"},
            "receipt_artifact_hash": {"const": "sha256:5e39ced6010ed4d8800b8cb34585184389956d68d194fdea533588aba2eb9351"}
          }
        }
      }
    },
    "audit_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_url", "current_main_at_audit", "current_tree",
        "framework_commit", "task_episode_schema_blob", "experience_substrate_blob"
