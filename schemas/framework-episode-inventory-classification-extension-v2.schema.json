        "current_tree": {"const": "38c29ac6fcb19baa3a14876a2ed081456ef1e70b"},
        "framework_commit": {"const": "fe47a12c4bad8253658baaf37e1300cab15d0823"},
        "task_episode_schema_blob": {"const": "aed1055565062a6adefe24eb48331e314d01adec"},
        "experience_substrate_blob": {"const": "814aa24788d796b9cec7e35b6373b5d5e7ffbc77"}
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/failure_experience_classification"},
        {"$ref": "#/$defs/failure_diagnosis_classification"}
      ],
      "items": false
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_receipt_modified", "prior_extension_modified",
        "source_containers_modified", "classification_extension_registered",
        "classification_basis"
      ],
      "properties": {
        "parent_receipt_modified": {"const": false},
        "prior_extension_modified": {"const": false},
        "source_containers_modified": {"const": false},
        "classification_extension_registered": {"const": true},
        "classification_basis": {"const": "EXPLICIT_CONTAINER_IDENTITY_AND_STRICT_TASK_EPISODE_SCHEMA_FAILURE"}
      }
    },
    "authority_contract": {"$ref": "#/$defs/all_false_authority"},
    "evidence_pointers": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_hash": {"$ref": "#/$defs/prefixed_sha256"}
  },
  "$defs": {
    "classification_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "container_kind", "observed_episode_id", "classification",
        "introduction_commit", "introduction_tree", "git_blob_sha", "raw_sha256",
        "current_main_blob_sha", "strict_task_episode_schema_verdict",
        "strict_task_episode_schema_error_count", "runtime_constructor_invoked",
        "runtime_constructor_disposition"
      ],
      "properties": {
        "path": {"type": "string"},
        "container_kind": {"type": "string"},
        "observed_episode_id": {"const": "EP-NS-B1a3b1-C001-R2-20260811"},
        "classification": {"const": "NON_TASK_EPISODE_CONTAINER_WITH_EPISODE_ID"},
        "introduction_commit": {"$ref": "#/$defs/git_sha"},
        "introduction_tree": {"$ref": "#/$defs/git_sha"},
        "git_blob_sha": {"$ref": "#/$defs/git_sha"},
        "raw_sha256": {"$ref": "#/$defs/raw_sha256"},
        "current_main_blob_sha": {"$ref": "#/$defs/git_sha"},
        "strict_task_episode_schema_verdict": {"const": "FAIL"},
        "strict_task_episode_schema_error_count": {"type": "integer", "minimum": 1},
        "runtime_constructor_invoked": {"const": false},
        "runtime_constructor_disposition": {"const": "NOT_APPLICABLE_NON_TASK_EPISODE_CONTAINER"}
      }
    },
    "failure_experience_classification": {
      "allOf": [
        {"$ref": "#/$defs/classification_common"},
