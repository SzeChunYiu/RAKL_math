            "container_kind": {"const": "FAILURE_EXPERIENCE_DELTA_PROPOSAL_SHADOW"},
            "introduction_commit": {"const": "04fd906c9d1fd5585f3fc3efa4e614703c675715"},
            "introduction_tree": {"const": "a42d22a47704debbbeaaed74f01b4e784093a86b"},
            "git_blob_sha": {"const": "3c722ea8c5c3e7ff25e56a4cec2a3f3753753b0d"},
            "raw_sha256": {"const": "8457393a7ef4f1ab8a931cee0106e08e5c024364b8d0783f9d12eed5f607afb0"},
            "current_main_blob_sha": {"const": "3c722ea8c5c3e7ff25e56a4cec2a3f3753753b0d"},
            "strict_task_episode_schema_error_count": {"const": 15}
          }
        }
      ]
    },
    "failure_diagnosis_classification": {
      "allOf": [
        {"$ref": "#/$defs/classification_common"},
        {
          "properties": {
            "path": {"const": "research/real_math/millennium/navier_stokes/07_memory/NS-B1a3b1_C001_R2_FAILURE_DIAGNOSIS_20260811.json"},
            "container_kind": {"const": "FAILURE_DIAGNOSIS_PROPOSAL_SHADOW"},
            "introduction_commit": {"const": "bc56b2ae70708509755efaf97a1ac8d462f42902"},
            "introduction_tree": {"const": "646ffafe928aef720129729246b10aeae88fb8ca"},
            "git_blob_sha": {"const": "fd14348ece534f40279308f46d9580345b7abca4"},
            "raw_sha256": {"const": "544b168886ded0268989b8622118d37f0aaa66e1d2f6ec4e064f467a33713b28"},
            "current_main_blob_sha": {"const": "fd14348ece534f40279308f46d9580345b7abca4"},
            "strict_task_episode_schema_error_count": {"const": 16}
          }
        }
      ]
    },
    "git_sha": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "raw_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "prefixed_sha256": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "all_false_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_mathematical_result", "grants_proof_authority",
        "grants_novelty_authority", "grants_millennium_root_authority",
        "grants_framework_authority", "grants_review_independence"
      ],
      "properties": {
        "grants_mathematical_result": {"const": false},
        "grants_proof_authority": {"const": false},
        "grants_novelty_authority": {"const": false},
        "grants_millennium_root_authority": {"const": false},
        "grants_framework_authority": {"const": false},
        "grants_review_independence": {"const": false}
      }
