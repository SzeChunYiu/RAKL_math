{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL_math/schemas/artifact-integrity-repair-receipt.schema.json",
  "title": "RAKL Math artifact integrity repair receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "recorded_at",
    "application_repository",
    "framework_pin",
    "subject",
    "observed_result",
    "diagnosis",
    "repair",
    "reusable_lesson_candidate",
    "evidence_pointers",
    "authority",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "application_repository": {"$ref": "#/$defs/repositoryCommit"},
    "framework_pin": {"$ref": "#/$defs/frameworkPin"},
    "subject": {"$ref": "#/$defs/subject"},
    "observed_result": {"$ref": "#/$defs/observedResult"},
    "diagnosis": {"$ref": "#/$defs/diagnosis"},
    "repair": {"$ref": "#/$defs/repair"},
    "reusable_lesson_candidate": {"$ref": "#/$defs/reusableLesson"},
    "evidence_pointers": {"$ref": "#/$defs/nonEmptyStrings"},
    "authority": {"type": "string", "minLength": 1},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "repositoryCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "base_commit"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "base_commit": {"$ref": "#/$defs/sha1"}
      }
    },
    "frameworkPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "commit": {"$ref": "#/$defs/sha1"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "artifact_kind",
        "source_commit",
        "source_path",
        "source_git_blob"
      ],
      "properties": {
        "atom_id": {"type": "string", "minLength": 1},
        "artifact_kind": {"type": "string", "minLength": 1},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "source_path": {"type": "string", "minLength": 1},
        "source_git_blob": {"$ref": "#/$defs/sha1"}
      }
    },
    "observedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stored_artifact_hash",
        "computed_canonical_hash",
        "invalid_file_sha256"
      ],
      "properties": {
        "status": {"const": "FAIL_HASH_INTEGRITY"},
        "stored_artifact_hash": {"$ref": "#/$defs/sha256"},
        "computed_canonical_hash": {"$ref": "#/$defs/sha256"},
        "invalid_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause_level", "status", "broken_assumption", "scope"],
      "properties": {
        "root_cause_level": {"const": "R1_SCHEMA_PARSER_UNITS_TRANSFORMATION"},
        "status": {"enum": ["BOUNDED_UNRESOLVED_CAUSE", "SUPPORTED_CAUSE", "VERIFIED_CAUSE"]},
        "broken_assumption": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "original_preserved",
        "invalid_path",
        "repaired_path",
        "repaired_file_sha256",
        "semantic_fields_changed",
        "identity_fields_changed"
      ],
      "properties": {
        "method": {"const": "PRESERVE_INVALID_COPY_AND_RECOMPUTE_CANONICAL_HASH_ONLY"},
        "original_preserved": {"const": true},
        "invalid_path": {"type": "string", "minLength": 1},
        "repaired_path": {"type": "string", "minLength": 1},
        "repaired_file_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_fields_changed": {"type": "array", "maxItems": 0},
        "identity_fields_changed": {
          "type": "array",
          "prefixItems": [{"const": "artifact_hash"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "reusableLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "preconditions", "guaranteed_effects", "non_guarantees", "known_failures", "target_validation_obligations"],
      "properties": {
        "status": {"const": "PROPOSAL_ONLY_PENDING_CROSS_PROBLEM_RECURRENCE_AND_FRAMEWORK_ASSURANCE"},
        "preconditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "guaranteed_effects": {"$ref": "#/$defs/nonEmptyStrings"},
        "non_guarantees": {"$ref": "#/$defs/nonEmptyStrings"},
        "known_failures": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_validation_obligations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
